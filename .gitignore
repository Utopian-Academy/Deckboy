# Build output
build/
dist/
builds/
*.o
*.d

# Project data (user-specific)
data/*.deckboy
data/project.json
data/posters/
data/last_project.txt

# Local screenshots
/Deckboy Screenshots/

# Media converter output (portable per-show cache)
_converted/

# Runtime logs. The show log records real cue NAMES from real shows, so this is
# a privacy rule, not just hygiene -- never let one reach the repo. In a portable
# install stateDir() IS data/, which is why they land there.
*.log
data/deckboy-*.log

# Python bytecode from tools/
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
compile_commands.json

# Node (companion module)
node_modules/

# Dev screenshots and reference images in root
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.mp4
/*.bmp

# Old version snapshots
Deckboy_0.55/

# UI playground (dev scratch)
UI Playground/

# Local fork reference (not part of this repo)
playboy/

# Working roadmap notes — kept locally, not part of the published repo
Notes

# Program recordings and the first-run marker — runtime output, not source
/data/recordings/
/data/deckboy-first-run

# Private notes: internal engineering material, kept off the public
# repository on purpose. See private-notes/README.md.
private-notes/
